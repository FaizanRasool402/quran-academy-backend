# ─────────────────────────────────────────────────────────────
# Aiza Quran Academy — Backend Environment Variables
# Hostinger Node.js panel mein ye sab "Environment Variables"
# section mein add karein (KEY = VALUE format)
# ─────────────────────────────────────────────────────────────

# Server port — Hostinger usually PORT apne aap set karta hai,
# agar nahi karta to 3000 use karein (Hostinger ka default)
PORT=3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.vhimdph.mongodb.net/?appName=Cluster0

# MongoDB database name
MONGODB_DB=quranacademy

# Gmail sender address
EMAIL_USER=aizaquranacademy@gmail.com

# Email jahan admin ko notifications ayengi
ADMIN_EMAIL=aizaquranacademy@gmail.com

# Gmail App Password (https://myaccount.google.com/apppasswords se banayein)
EMAIL_APP_PASSWORD=your_gmail_app_password

# Google DNS force — Hostinger DNS issues se bachne ke liye "1" rakhein
# agar MongoDB connect ho raha hai to "1" zaroor set karein
MONGODB_SKIP_GOOGLE_DNS=0

# Node environment
NODE_ENV=production
