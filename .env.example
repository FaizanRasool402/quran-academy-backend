# Primary frontend origin (single URL). Prefer setting this OR use CORS_ORIGINS below.
CORS_ORIGIN=https://YOUR-FRONTEND.hostingersite.com

# Extra allowed browser origins — comma-separated, no trailing slashes.
# Add your Hostinger frontend + custom domain variants, e.g.:
# CORS_ORIGINS=https://www.yoursite.com,https://yoursite.com
CORS_ORIGINS=
